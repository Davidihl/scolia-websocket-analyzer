{
  "manifest_version": 3,
  "name": "Scolia Score Reader",
  "version": "1.0.0",
  "description": "Logs incoming WebSocket messages to DevTools.",
  "permissions": [
    "storage"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Scolia Score Reader",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://game.scoliadarts.com/game",
        "https://game.scoliadarts.com/game/*"
      ],
      "js": [
        "websocket-logger.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  }
}
