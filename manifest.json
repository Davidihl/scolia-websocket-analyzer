{
  "manifest_version": 3,
  "name": "Scolia Score Reader",
  "version": "1.0.0",
  "description": "Logs incoming WebSocket messages to DevTools.",
  "permissions": ["storage"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "content_scripts": [
    {
      "matches": [
        "https://game.scoliadarts.com/game",
        "https://game.scoliadarts.com/game/*"
      ],
      "js": ["websocket-logger.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}
